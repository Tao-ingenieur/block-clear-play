{
  "name": "dropgrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "description": "方块消消看 / DropGrid Echo — original block puzzle game",
  "author": "Tao-ingenieur",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=packages/core/src/** --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test --test-isolation=none tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "dev:web": "vite apps/web --host 127.0.0.1",
    "build:web": "node tools/build-web.mjs",
    "preview:web": "vite preview apps/web --host 127.0.0.1 --outDir ../../../dist/web",
    "build:core": "tsc -p tsconfig.build.json && node tools/core-package.mjs",
    "build": "pnpm build:core && pnpm build:web",
    "build:windows": "pnpm build:web && node tools/build-icon.mjs && node node_modules/electron/install.js && node tools/build-windows.mjs",
    "smoke:desktop": "node tools/smoke-desktop.mjs",
    "smoke:windows": "node tools/smoke-desktop.mjs --packaged",
    "demo": "node tools/simulate.ts",
    "verify:build": "node tools/verify-build.mjs",
    "verify": "pnpm typecheck && pnpm test:coverage && pnpm build && pnpm verify:build",
    "build:android": "pnpm build:web && gradle -p apps/android --no-daemon assembleDebug lintDebug && node tools/package-android.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
